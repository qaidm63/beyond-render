# ============================================================
# Shadow Matrix — environment template
# Copy to `.env` and fill in. `.env` is git-ignored. Never commit real values.
# All secrets are supplied MANUALLY by the system operator.
# ============================================================

# --- Supabase (PostgreSQL + pgvector) -----------------------
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# Server-side only. Bypasses row-level security. Never expose to a browser.
SUPABASE_SECRET_KEY="sb_secret_PLACEHOLDER"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_PLACEHOLDER"
SUPABASE_JWKS_URL="https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json"
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# --- Gemini (embeddings + analysis) -------------------------
GEMINI_API_KEY="PLACEHOLDER"
GEMINI_MODEL="gemini-3-flash-preview"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# --- Telegram ops alerts (Phase 4) --------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---- Phase 4: pitches & scheduling ----
# Origin recruiters actually reach. Used to build absolute /vip/<id> links.
# Leave blank and the Tailor emits a relative path instead of guessing.
PUBLIC_BASE_URL=""
# Periodic sweep interval in minutes. 0 or unset = scheduler disabled.
# Values below 5 are clamped to 5. Enable in ONE process only.
SWEEP_INTERVAL_MINUTES="0"

# ---- AMD Radeon Cloud (OpenAI-compatible, rotating key pool) ----
# Comma-separated keys consumed round-robin. Any key that returns 429 or a
# transient server error is isolated for 60s while the request fails over to
# the next key. Keys are supplied manually by the operator, never generated.
AMD_BASE_URL="https://developer.amd.com.cn/radeon/api/v1"
AMD_API_KEYS=""

# Per-agent model assignment. Overridable because the Token Factory catalogue
# is a live beta and model ids rotate.
AMD_MODEL_VISION="Qwen3.8-27B"
AMD_MODEL_ANALYST="MiniCPM5-2B"
AMD_MODEL_TAILOR="DeepSeek-V4-Flash-0731"

# Portfolio Studio narrative synthesis. Largest model in the catalogue on
# purpose: a case study must sustain a long architectural argument.
AMD_MODEL_CURATOR="DeepSeek-V4-Flash-0731"

# Asset inspection. Must be genuinely multimodal — AMD_MODEL_VISION above is
# TEXT-only and is used for DOM extraction, not for reading renderings.
CURATOR_VISION_MODEL="gemini-3-flash-preview"
# Optional: a vision-capable AMD model, used only when GEMINI_API_KEY is absent.
# AMD_MODEL_CURATOR_VISION="DeepSeek-V4-Flash-Vision-Exp"

# --- Operator auth (Phase 3) --------------------------------
# Supabase Auth. The backend verifies every operator JWT against the JWKS
# endpoint. ADMIN_EMAILS is the authorisation allowlist: a valid Supabase user
# is NOT an operator unless their email appears here.
ADMIN_EMAILS="you@example.com"
# Only needed for legacy HS256 projects, as a fallback verifier:
SUPABASE_JWT_SECRET=""

# --- Local dev ----------------------------------------------
ALLOWED_ORIGINS="http://localhost:5173"
BACKEND_URL="http://127.0.0.1:8000"

# --- Browser session for the DOM engine ---------------------
# Not an env var: export cookies manually from an authenticated browser
# session and save as backend/cookies.json (Playwright storage format).

# supabase-py 2.x still validates for legacy JWT-format keys. If the modern
# sb_secret_* key is rejected, supply the JWT service-role key here instead.
SUPABASE_SERVICE_ROLE_JWT=""
SUPABASE_ANON_JWT=""

# --- Frontend build-time vars (also place in frontend/.env.local) ---
# ANON key only. The service key must never be exposed to a browser.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="PLACEHOLDER_ANON_KEY"
