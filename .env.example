# ============================================================
# Shadow Matrix — environment template
# Copy to `.env` and fill in. `.env` is git-ignored. Never commit real values.
# All secrets are supplied MANUALLY by the system operator.
# ============================================================

# --- Supabase (PostgreSQL + pgvector) -----------------------
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# Server-side only. Bypasses row-level security. Never expose to a browser.
SUPABASE_SECRET_KEY="sb_secret_PLACEHOLDER"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_PLACEHOLDER"
SUPABASE_JWKS_URL="https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json"
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# --- Gemini (embeddings + analysis) -------------------------
GEMINI_API_KEY="PLACEHOLDER"
GEMINI_MODEL="gemini-3-flash-preview"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# --- Telegram ops alerts (Phase 4) --------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Admin session (Phase 3) --------------------------------
ADMIN_SESSION_SECRET=""

# --- Local dev ----------------------------------------------
ALLOWED_ORIGINS="http://localhost:5173"
BACKEND_URL="http://127.0.0.1:8000"

# --- Browser session for the DOM engine ---------------------
# Not an env var: export cookies manually from an authenticated browser
# session and save as backend/cookies.json (Playwright storage format).

# supabase-py 2.x still validates for legacy JWT-format keys. If the modern
# sb_secret_* key is rejected, supply the JWT service-role key here instead.
SUPABASE_SERVICE_ROLE_JWT=""
SUPABASE_ANON_JWT=""
